# ─────────────────────────────────────────────────────────────
#  THE SIR ARCHIVES — environment configuration
#  Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Port the Express server listens on
PORT=3000

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/sir-archives.db

# REQUIRED for /admin. Pick something long. Never commit `.env`.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign admin session tokens. If left empty a random
# secret is generated at startup (admin sessions reset on restart).
SESSION_SECRET=

# Admin session lifetime in hours
ADMIN_SESSION_HOURS=12

# Comma-separated list of allowed CORS origins (only needed if the
# frontend is hosted on a different domain than the API)
CORS_ORIGINS=

# Set to "production" when deploying
NODE_ENV=development
