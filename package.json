{
  "name": "sir-archives",
  "version": "1.0.0",
  "description": "The SIR Archives — an absurdly over-engineered cinematic birthday roast experience for Shreaysh Shenal Munda.",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "photos:sync": "node scripts/sync-photos.js",
    "photos:optimize": "node scripts/optimize-photos.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "gsap": "^3.12.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
